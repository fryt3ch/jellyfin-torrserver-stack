# Copy this file to .env and adjust the values.

# UID/GID that own the media and config files.
PUID=1000
PGID=1000

# Host paths.
JELLYFIN_CONFIG=./data/jellyfin/config
DOWNLOADS_PATH=./data/downloads
TORRSERVER_DATA=./data/torrserver
GLUETUN_DATA=./data/gluetun

# When the VPN profile is enabled, this is the host interface/address the
# TorrServer port is published on. Use 0.0.0.0 for all interfaces or a LAN IP
# such as 192.168.1.10 to restrict access.
TORRSERVER_BIND_IP=0.0.0.0

# --- VPN (only used with the vpn profile) ---
# Gluetun "custom" WireGuard provider. For Cloudflare WARP, generate a profile
# with wgcf (https://github.com/ViRb3/wgcf) and map the values below.
# See the "Cloudflare WARP" section in README.md.
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_MTU=1280
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PUBLIC_KEY=
# Must be an IPv4 address; 162.159.192.1 is a WARP endpoint.
WIREGUARD_ENDPOINT_IP=162.159.192.1
WIREGUARD_ENDPOINT_PORT=2408
# Optional keepalive to keep NAT mappings open.
WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL=25s
